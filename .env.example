# --- Required ---------------------------------------------------------------
TOKEN=MyBotToken
GUILD_ID=1234567890
OWNERS=Owner1ID,Owner2ID

# --- Database: JSON files (no MongoDB needed) -------------------------------
DATABASE_TYPE=json
# Where the JSON files are stored. Defaults to ./data inside the bot folder.
# DATA_DIR=/home/modmail/modmail-data

# --- Logs --------------------------------------------------------------------
# Logs are delivered as .txt transcripts in Discord (?logs, ?logs key, ?loglink,
# and on every closed thread in the log channel). Nothing else is needed.
#
# OPTIONAL: also serve logs as web pages. Uncomment both lines, open the port
# in your firewall, and log links will appear next to the .txt files.
# LOG_VIEWER_PORT=8000
# LOG_URL=http://YOUR_SERVER_IP:8000

# --- Keep this! -------------------------------------------------------------
# Auto-updates do a `git pull` from the official repo, which would overwrite
# the JSON database changes. Leave this set to true.
DISABLE_AUTOUPDATES=true
